# ==============================================================================
# Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Heroku, set these variables using the Heroku CLI:
#   heroku config:set SECRET_KEY='your-secure-random-key'
#   heroku config:set DEBUG=False
#   heroku config:set ALLOWED_HOST='your-app-name.herokuapp.com'
# ==============================================================================

# Django Secret Key (Never expose your production secret key!)
SECRET_KEY=django-insecure-local-dev-secret-key-change-in-production

# Debug Mode: True for local development, False for Heroku production
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOST=127.0.0.1,localhost

# Database URL:
# - Leave blank or unset locally to use SQLite (when DEBUG=True)
# - On Heroku, this is AUTOMATICALLY injected by the Heroku Postgres add-on!
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
